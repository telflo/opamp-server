# -----------------------------------------------------------------------------
# What `serve` and `migrate` read, by section; docs/configuration.md documents
# each variable. `serve agent` reads only the agent endpoint's and the shared
# ones (never the management secret); `serve management` only the management
# API's and the shared ones (never OPAMP_SERVER_URL). The server reads its environment, not this file: export
# them, or hand them over through your orchestrator (or `docker run
# --env-file`). compose.yaml at the repository's root sets the development
# stack's.
# -----------------------------------------------------------------------------

# -- Management API ----------------------------------------------------------
# The values below are examples, never real credentials: generate your own.
# The server reads its environment, not this file: export them, or hand them
# over through your orchestrator (or `docker run --env-file`).
#
# The server's own role (telflo_opamp, a member of telflo_opamp_runtime).
# Required by `serve`. Size its connection pool with ?pool_max_conns=<n> on
# the URL (docs/configuration.md gives the default): /ready adds one connection of its
# own, so Postgres's max_connections must hold replicas × (n + 1).
# OPAMP_DATABASE_URL=postgresql://telflo_opamp:<password>@localhost:5432/telflo_opamp?pool_max_conns=10
#
# The database's owner (telflo_opamp_owner). Required by `migrate` only; the
# running server never holds it. Take a backup before every `migrate up`.
# OPAMP_MIGRATION_DATABASE_URL=postgresql://telflo_opamp_owner:<password>@localhost:5432/telflo_opamp
#
# Required by `serve`: the shared secret callers send as
# `Authorization: Bearer <secret>`, at least 32 bytes. Generate it, e.g.
# `openssl rand -base64 48`.
# OPAMP_MANAGEMENT_SECRET=
#
# Optional: true lets `serve` start with compose.yaml's committed
# development secret and encryption key, which it refuses otherwise. Only
# compose.yaml sets it; never set it in a deployment.
# OPAMP_ALLOW_DEVELOPMENT_SECRETS=false
#
# Optional, comma-separated: secrets still accepted while a rotation rolls
# out (docs/security.md, "Rotating it"). Each at least 32 bytes.
# OPAMP_MANAGEMENT_SECRETS_PREVIOUS=
#
# Optional: the management port (default 51235), read by `serve` and
# `healthcheck` alike.
# OPAMP_MANAGEMENT_PORT=51235
#
# Optional: the interface to listen on (default: every interface, as a
# container needs). 127.0.0.1 keeps the port off the network entirely.
# OPAMP_MANAGEMENT_HOST=127.0.0.1
#
# Optional, both or neither: serve the management API over TLS (1.2 or
# later). Without them it speaks plain HTTP and the secret crosses the
# network in the clear, so keep the port on a private network.
# OPAMP_MANAGEMENT_TLS_CERT_FILE=/path/to/management.crt
# OPAMP_MANAGEMENT_TLS_KEY_FILE=/path/to/management.key

# -- Agent endpoint ----------------------------------------------------------
# Where collectors poll (POST /opamp/api/v1), with an enrollment token's
# bearer: its own port, apart from the management API's, behind its own
# load balancer in production, never the web gateway.
#
# Required: the agent endpoint's public URL, as collectors reach it. Every
# collector is handed it with its rotate token and polls it from then on, so
# a URL they can't reach strands them until they restart. http or https, a
# host, a port from 1 to 65535 or none, no user name, password, query or
# fragment. `serve` warns when its host is a loopback address (a collector
# in a container or on another machine can't reach it), and when its path
# isn't /opamp/api/v1.
# OPAMP_SERVER_URL=https://opamp.example.com/opamp/api/v1
#
# Optional: the agent port (default 51234) and the interface to listen on
# (an IP address; default every interface, as a container needs).
# OPAMP_AGENT_PORT=51234
# OPAMP_AGENT_HOST=127.0.0.1
#
# Optional: the most connections the agent endpoint holds open at once,
# idle ones included (10000; from 1 to 1000000). Past it, a new connection
# waits until one closes. A collector polling directly keeps one open.
# OPAMP_AGENT_MAX_CONNECTIONS=10000
#
# Optional, both or neither: serve the agent endpoint over TLS (1.2 or
# later). Without them it speaks plain HTTP, and `serve` says it expects a
# TLS-terminating load balancer in front.
# OPAMP_AGENT_TLS_CERT_FILE=/path/to/agent.crt
# OPAMP_AGENT_TLS_KEY_FILE=/path/to/agent.key
#
# Optional: a diagnostics listener (Go's profiles, the admission view) for
# the agent endpoint, on a loopback address only (127.0.0.1 by default, or
# ::1; any other is refused: it has no authentication). For `serve agent`,
# which has no management secret to put them behind. Unset, there is none.
# OPAMP_AGENT_DIAGNOSTICS_PORT=6060
# OPAMP_AGENT_DIAGNOSTICS_HOST=127.0.0.1
#
# Required, one of the two: the key the enrollment tokens' bearers are
# encrypted with (AES-256-GCM; the AES key is the SHA-256 of this text), at
# least 32 bytes, with no whitespace at either end (a file's final line
# ending is dropped, nothing else). Prefer the file, mounted as a
# secret: `serve` unsets the variable after reading it, but the value
# stays in the process's initial environment. Generate it, e.g.
# `openssl rand -base64 48`. An existing key with whitespace at either end
# is refused: replace it (and mint new bearers), never trim it.
# OPAMP_ENCRYPTION_KEY_FILE=/run/secrets/opamp_encryption_key
# OPAMP_ENCRYPTION_KEY=
#
# Optional, one of the two, during a key rotation (docs/security.md, "The
# encryption key"): earlier keys, comma separated, at most 8, each at least
# 32 bytes. Bearers made under them still authenticate; new ones are made
# under the current key.
# OPAMP_ENCRYPTION_KEYS_PREVIOUS_FILE=/run/secrets/opamp_encryption_keys_previous
# OPAMP_ENCRYPTION_KEYS_PREVIOUS=
#
# Optional: the heartbeat pushed to collectors with their connection
# settings, in seconds (30; from 10 to 300).
# OPAMP_HEARTBEAT_INTERVAL_SECONDS=30
#
# Optional, the limits, each counted per pod (so a fleet-wide figure is the
# limit times the number of pods):
# - requests handled at once; past it a poll is shed with 429 and a
#   Retry-After (100);
# OPAMP_MAX_CONCURRENT_REQUESTS=100
# - one organization's requests handled at once, at most the above; past it
#   that organization's polls are shed the same way (25, or the cap above
#   if lower);
# OPAMP_MAX_CONCURRENT_REQUESTS_PER_ORGANIZATION=25
# - an organization's polls a minute when its own limit (the management
#   API's /limits) is unset (12000: about 6,000 collectors at the 30-second
#   heartbeat);
# OPAMP_DEFAULT_REQUESTS_PER_MINUTE=12000
# - one collector's polls a minute, with a burst of 20 (60: a collector
#   polls twice a minute, and a few times more on connecting or on a push).
# OPAMP_COLLECTOR_REQUESTS_PER_MINUTE=60
#
# Optional: once told to stop, how long serve keeps both listeners open
# while /ready answers 503, so a load balancer's readiness checks see it
# before the port closes (5; from 0 to 30; 0 with a Kubernetes preStop
# sleep doing the waiting). The stop grace period must cover it.
# OPAMP_SHUTDOWN_DRAIN_SECONDS=5

# -- Observability --------------------------------------------------------
# OTLP gRPC endpoint for self-telemetry (traces + logs + runtime metrics).
# UNSET/EMPTY = telemetry disabled (no-op) — no exporters, no connection errors.
# http:// = plaintext, https:// = TLS. For local dev, leave unset (telemetry off)
# or point at a collector you run.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://telflo-collector:4317
# OTEL_SERVICE_NAME=telflo-opamp-server        # defaults to this if unset
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=telflo
# OTEL_COLLECTOR_ADDR=localhost:4317           # DEPRECATED: legacy alias, migrated with a warning
